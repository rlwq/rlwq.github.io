---
import { allTags, tagUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Slug of the tag whose page this is; none on the home page. */
  current?: string;
}

const { posts, current } = Astro.props;
const tags = allTags(posts);
// Same soft pills as the tags on posts; the selected one is filled.
const pill =
  'rounded-full px-3 py-1 transition-colors aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground';
const tagPill = `${pill} bg-primary/10 text-primary hover:bg-primary/20`;
const allPill = `${pill} bg-muted text-muted-foreground hover:text-foreground`;
---

{
  tags.length > 0 && (
    <nav class="mb-4 flex flex-wrap gap-1.5 font-sans text-[13px] leading-5" aria-label="Tags">
      <a class={allPill} href="/" aria-current={current ? undefined : 'page'}>
        All
      </a>
      {tags.map((t) => (
        <a class={tagPill} href={tagUrl(t.name)} aria-current={current === t.slug ? 'page' : undefined}>
          {t.name}
        </a>
      ))}
    </nav>
  )
}
