---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { coverPosClass } from '../lib/cover';
import { isoDay, postUrl, readingMinutes, tocAttrs, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const items = await Promise.all(
  posts.map(async (post) => {
    const { headings } = await render(post);
    const sections = headings.filter((h) => h.depth === 2 || h.depth === 3);
    return { post, sections, minutes: readingMinutes(post.body ?? '') };
  }),
);
---

<!-- Each card is two CRT tubes in one frame (.tube, lamp.css "vignette"): the cover with
     the title, and a monitor with the contents. Without a cover the left tube shows the
     title on its own, with the glare like the monitor. -->
<ul class="grid gap-5" data-post-cards>
  {
    items.map(({ post, sections, minutes }) => {
      const { title, date, tags, cover, coverPosition } = post.data;
      const href = postUrl(post.id);

      return (
        <li class="card-item relative isolate">
          <div class="card-shell flex flex-col overflow-hidden rounded-md border md:flex-row md:items-stretch">
            <article
              class="tube relative isolate flex min-h-[152px] flex-1 flex-col overflow-hidden bg-tube md:h-[164px]"
              data-glare={cover ? undefined : ''}
            >
              <a href={href} class="card-link absolute inset-0 z-10" aria-label={title} />

              {cover && (
                <Image
                  src={cover}
                  alt=""
                  widths={[640]}
                  sizes="640px"
                  aria-hidden="true"
                  class:list={['card-cover pointer-events-none absolute inset-0 h-full w-full object-cover', coverPosClass[coverPosition]]}
                />
              )}

              <div
                class:list={[
                  'pointer-events-none relative z-20 flex flex-1 flex-col px-5 py-4',
                  cover ? 'justify-end pt-14 md:pt-4' : 'justify-between gap-3',
                ]}
              >
                {!cover && <span class="block h-[2.5px] w-9 bg-primary" aria-hidden="true" />}

                <div>
                  {/* over the picture the text is brighter than the palette, so it reads over the image */}
                  <h3
                    class:list={[
                      'text-[21px] leading-[1.2] font-medium tracking-[-0.015em] text-balance sm:text-[23px]',
                      cover ? 'text-[#fafaf9]' : 'text-foreground',
                    ]}
                  >
                    {title}
                  </h3>

                  <p
                    class:list={[
                      'mt-2 font-mono text-[11px] leading-5 tracking-[0.06em] uppercase',
                      cover ? 'text-[#d6d3ce]/85' : 'text-muted-foreground',
                    ]}
                  >
                    <time datetime={date.toISOString()}>{isoDay(date)}</time>
                    <span class="mx-2 opacity-50" aria-hidden="true">·</span>
                    <span>{minutes} min read</span>
                  </p>

                  {tags.length > 0 && (
                    <div class="mt-2.5 flex flex-wrap gap-x-3.5 gap-y-1">
                      {tags.map((t) => (
                        <span class="card-tag font-mono text-[11px] leading-4 tracking-[0.06em] text-primary uppercase">{t}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </article>

            {sections.length > 0 && (
              <nav
                aria-label={`Sections in ${title}`}
                class="tube card-toc-monitor relative isolate flex max-h-[160px] shrink-0 flex-col overflow-hidden bg-tube md:h-[164px] md:max-h-none md:w-[195px] xl:w-[205px]"
                data-glare
              >
                <ol class="relative z-10 h-full overflow-y-auto px-3.5 py-2.5 font-mono text-[11.5px] leading-[17px]">
                  {sections.map((sec, i) => (
                    <li class="mb-1 last:mb-0" data-depth={sec.depth}>
                      <a
                        href={`${href}#${sec.slug}`}
                        {...tocAttrs(sections, i)}
                        class="-ml-2.5 block pl-2.5 text-foreground/85 transition-colors hover:text-foreground"
                      >
                        {sec.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

<noscript>
  <style>
    .card-cover {
      opacity: 0.4;
    }
  </style>
</noscript>

<script>
  import '../scripts/covers';
</script>

<style is:global>
  /* CRT covers, painted by scripts/covers.ts. The <img> is only their source: it stays
     invisible, unless scripts are off (<noscript> above) or painting failed. */
  .card-cover {
    opacity: 0;
  }
  .crt-failed .card-cover {
    opacity: 0.4;
  }
  .card-crt {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    /* the screen warms up like phosphor: as slowly as a glow goes out */
    transition: opacity var(--lamp-out) var(--lamp-out-ease);
    /* dim the lower-left area where the title and tags sit */
    -webkit-mask-image: radial-gradient(85% 95% at 0% 100%, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.34) 48%, #000 100%);
    mask-image: radial-gradient(85% 95% at 0% 100%, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.34) 48%, #000 100%);
  }
  .has-crt .card-crt {
    opacity: 1;
  }
</style>
