---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Column from './Column.astro';
import PageHeader from './PageHeader.astro';
import Toc from './Toc.astro';
import { getGraph, isoDay, postUrl, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, updated, tags, toc: tocSetting } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocSetting ?? toc.filter((h) => h.depth === 2).length >= 3;
const minutes = readingMinutes(post.body ?? '');

const { backlinks: allBacklinks } = await getGraph();
const backlinks = allBacklinks.get(post.id) ?? [];

// the same small label as ABOUT, PROJECTS and ARTICLES on the home page
const label = 'mb-3 font-mono text-[11.5px] tracking-[0.06em] text-muted-foreground uppercase';
---

<Column as="article">
  {showToc && <Toc headings={toc} variant="side" />}

  <PageHeader title={title}>
    {
      tags.length > 0 && (
        <span class="inline-flex flex-wrap items-center gap-1.5">
          {tags.map((t) => (
            <button type="button" class="cursor-pointer rounded-full bg-primary/10 px-2.5 py-0.5 font-sans text-xs leading-4 text-primary transition-colors hover:bg-primary/20" data-tag={t}>
              {t}
            </button>
          ))}
        </span>
      )
    }
    <time datetime={date.toISOString()}>{isoDay(date)}</time>
    {updated && <span>Updated {isoDay(updated)}</span>}
    <span>{minutes} min read</span>
  </PageHeader>

  {showToc && <Toc headings={toc} variant="inline" />}

  <div>
    <Content />
  </div>

  {
    backlinks.length > 0 && (
      <footer class="mt-14">
        <section aria-labelledby="backlinks-label">
          <h2 class={label} id="backlinks-label">
            Linked from
          </h2>
          <ul class="grid gap-2.5">
            {backlinks.map(({ post: from, context }) => (
              <li>
                <a class="block rounded-md border px-3.5 py-3 transition-colors hover:bg-muted" href={postUrl(from.id)}>
                  <span class="mb-1 block font-sans text-[13px] leading-[18px] font-semibold">{from.data.title}</span>
                  {context && <span class="block text-sm leading-[22px] text-muted-foreground">{context}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </footer>
    )
  }
</Column>

<script>
  import '../scripts/toc';
  import '../scripts/code';
  import '../scripts/lightbox';
</script>
