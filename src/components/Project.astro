---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { coverPosClass } from '../lib/cover';
import { projectCaption, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, url, repo, tags, cover, coverPosition } = project.data;
const { Content } = await render(project);
const caption = projectCaption(project);
---

<!-- Built like an article page: the same title, the same tags in the header, the cover
     shown like the plate at the top of an article (no frame), then the text. -->
<article class="relative mx-auto max-w-[880px] px-8 pt-10 pb-24 max-sm:px-4 max-sm:pt-8">
  <header class="mb-9" data-project-header>
    <h1 class="mb-3 text-[36px] leading-[42px] font-medium tracking-[-0.01em] text-balance max-sm:text-[30px] max-sm:leading-9">
      {title}
    </h1>

    <p class="max-w-[680px] text-[19px] leading-[29px] text-muted-foreground">
      {description}
    </p>

    {
      (url || repo || tags.length > 0) && (
        <div class="mt-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-2.5">
          {(url || repo) && (
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[12.5px]">
              {url && (
                <a class="home-link text-primary no-underline" href={url} target="_blank" rel="noreferrer">
                  {caption} ↗
                </a>
              )}
              {repo && (
                <a class="home-link text-primary no-underline" href={repo} target="_blank" rel="noreferrer">
                  {repo.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗
                </a>
              )}
            </div>
          )}

          {tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1">
              {tags.map((t) => (
                <span class="project-tag font-mono text-[12px] leading-4 tracking-[0.06em] text-primary uppercase">{t}</span>
              ))}
            </div>
          )}
        </div>
      )
    }
  </header>

  {
    cover && (
      <figure class="mb-8">
        <Image
          src={cover}
          alt={title}
          widths={[720, 1240]}
          sizes="(max-width: 880px) 100vw, 816px"
          class:list={['block aspect-[1600/690] w-full rounded-sm object-cover dark:brightness-90', coverPosClass[coverPosition]]}
        />
      </figure>
    )
  }

  <div>
    <Content />
  </div>
</article>

<script>
  import '../scripts/code';
  import '../scripts/lightbox';
</script>
