---
// Page title with a small grey line under it (date, count, tagline...).
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="mb-9">
  <h1 class="mb-1.5 text-[36px] leading-[42px] font-medium tracking-[-0.01em] text-balance max-sm:text-[30px] max-sm:leading-9">
    {title}
  </h1>
  {
    Astro.slots.has('default') && (
      <p class="flex flex-wrap gap-x-3.5 font-sans text-[13px] leading-5 text-muted-foreground">
        <slot />
      </p>
    )
  }
</header>
