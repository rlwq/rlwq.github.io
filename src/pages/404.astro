---
import Base from '../layouts/Base.astro';
import Column from '../components/Column.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Not found">
  <Column>
    <PageHeader title="Page not found">It may have been renamed, or not written yet.</PageHeader>
    <p>Search with <kbd>/</kbd>, or go back to the <a class="text-primary no-underline transition-opacity hover:opacity-75" href="/">home page</a> for all articles.</p>
  </Column>
</Base>
