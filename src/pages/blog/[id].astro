---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { clip, getPosts, toPlain, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const description = post.data.description ?? clip(toPlain(post.body ?? ''), 160);
---

<Base title={post.data.title} description={description} type="article" ogImage={`/og/${post.id}.png`}>
  <Article post={post} />
</Base>
